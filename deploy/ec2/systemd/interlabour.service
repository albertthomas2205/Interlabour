# Non-Docker deploy only.
# Install: sudo cp deploy/ec2/systemd/interlabour.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now interlabour

[Unit]
Description=Interlabour Gunicorn
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/interlabour
EnvironmentFile=/var/www/interlabour/.env
ExecStart=/var/www/interlabour/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --threads 4 \
    --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
