# Copy to the server as /var/www/interlabour/.env
# cp deploy/ec2/env.production.example /var/www/interlabour/.env

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False

# --- Phase 1: EC2 public IP only (HTTP, no domain yet) ---
# Replace 13.238.45.181 with your instance public IP.
DJANGO_ALLOWED_HOSTS=13.238.45.181
DJANGO_CSRF_TRUSTED_ORIGINS=http://13.238.45.181
PUBLIC_SITE_URL=http://13.238.45.181
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CORS_ALLOW_ALL_ORIGINS=True

# --- Phase 2: after GoDaddy DNS + certbot (uncomment and remove Phase 1 lines) ---
# DJANGO_ALLOWED_HOSTS=13.238.45.181,interlabour.nl,www.interlabour.nl
# DJANGO_CSRF_TRUSTED_ORIGINS=https://interlabour.nl,https://www.interlabour.nl,http://13.238.45.181
# PUBLIC_SITE_URL=https://www.interlabour.nl
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://www.interlabour.nl,https://interlabour.nl

DJANGO_SECURE_SSL_REDIRECT=False

# AWS RDS PostgreSQL
DATABASE_URL=postgres://interlabour_admin:YOUR_RDS_PASSWORD@YOUR_RDS_ENDPOINT.eu-west-1.rds.amazonaws.com:5432/interlabour_db

PORT=10000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Zoho SMTP (use app passwords, not login passwords)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=hr@interlabour.nl
EMAIL_HOST_PASSWORD=your-zoho-hr-app-password
DEFAULT_FROM_EMAIL=Interlabour <hr@interlabour.nl>

SUPPORT_EMAIL_HOST_USER=support@interlabour.nl
SUPPORT_EMAIL_HOST_PASSWORD=your-zoho-support-app-password
SUPPORT_FROM_EMAIL=Interlabour <support@interlabour.nl>

HR_EMAIL_HOST_USER=hr@interlabour.nl
HR_EMAIL_HOST_PASSWORD=your-zoho-hr-app-password
HR_FROM_EMAIL=Interlabour <hr@interlabour.nl>

OTP_FROM_EMAIL=Interlabour <support@interlabour.nl>
OTP_FROM_MAILBOX=support@interlabour.nl
EMAIL_INLINE_LOGO=True

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Optional first deploy only — change passwords after go-live
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@interlabour.nl
DJANGO_SUPERUSER_PASSWORD=change-me
BOOTSTRAP_USER_USERNAME=
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=
